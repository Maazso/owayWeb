---
// @ts-ignore
import { Icon } from "astro-icon";
---

<div class="mt-24 mb-16 -mx-5 px-5 py-16 md:py-20" style="background: linear-gradient(135deg, #F8F4EE 0%, #E8DED0 100%);">
  <div class="max-w-screen-xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl lg:text-5xl font-bold text-slate-900">How OWAY Works</h2>
      <p class="text-lg mt-4 text-slate-700 max-w-2xl mx-auto">
        Get started in minutes. OWAY integrates seamlessly with your existing tools and starts working for you immediately.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <!-- Step 1 -->
      <div class="relative">
        <div class="bg-blue-100 text-blue-600 w-16 h-16 rounded-full flex items-center justify-center text-2xl font-bold mb-6 mx-auto">
          1
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-3 text-center">Connect Your Accounts</h3>
        <p class="text-slate-700 text-center leading-relaxed">
          Link your email, calendar, and phone system in just a few clicks. OWAY supports Gmail, Outlook, Google Calendar, and more.
        </p>

        <!-- Arrow for desktop -->
        <div class="hidden md:block absolute top-8 -right-4 text-slate-400 text-3xl">
          →
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative">
        <div class="bg-purple-100 text-purple-600 w-16 h-16 rounded-full flex items-center justify-center text-2xl font-bold mb-6 mx-auto">
          2
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-3 text-center">Set Your Preferences</h3>
        <p class="text-slate-700 text-center leading-relaxed">
          Tell OWAY your scheduling preferences, communication style, and priorities. The AI learns from your behavior and gets smarter over time.
        </p>

        <!-- Arrow for desktop -->
        <div class="hidden md:block absolute top-8 -right-4 text-slate-400 text-3xl">
          →
        </div>
      </div>

      <!-- Step 3 -->
      <div>
        <div class="bg-green-100 text-green-600 w-16 h-16 rounded-full flex items-center justify-center text-2xl font-bold mb-6 mx-auto">
          3
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-3 text-center">Let OWAY Work</h3>
        <p class="text-slate-700 text-center leading-relaxed">
          OWAY automatically triages your inbox, schedules meetings, handles calls, and keeps you informed. Reclaim 10+ hours per week instantly.
        </p>
      </div>
    </div>

    <!-- Social Proof / Stats Section -->
    <div class="mt-16 bg-white rounded-2xl p-8 border border-stone-300 shadow-sm max-w-5xl mx-auto">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-slate-900">10+</div>
          <div class="text-slate-700 mt-2">Hours saved per week</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-slate-900">95%</div>
          <div class="text-slate-700 mt-2">Email accuracy rate</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-slate-900">24/7</div>
          <div class="text-slate-700 mt-2">Always available</div>
        </div>
      </div>
    </div>
  </div>
</div>
