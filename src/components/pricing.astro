---
import { Tick } from "@components/ui/icons";
import Link from "@components/ui/link.astro";

const { plan } = Astro.props;
---

<div class="pb-10 h-full">
  <div
    class={`flex flex-col h-full w-full relative border-2 py-8 px-6 rounded-xl transition-all ${
      plan.popular
        ? "border-black bg-white shadow-xl scale-105"
        : "border-slate-200 bg-white shadow-md hover:shadow-lg"
    }`}>

    {plan.popular && (
      <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
        <span class="bg-black text-white text-sm font-semibold px-4 py-1 rounded-full">
          Most Popular
        </span>
      </div>
    )}

    <div class="text-center">
      <h4 class="text-lg font-semibold text-slate-900">{plan.name}</h4>
      <div class="mt-4">
        {plan.price && typeof plan.price === "string" && plan.price.includes("/") ? (
          <div class="flex items-baseline justify-center gap-1">
            <span class="text-4xl md:text-5xl font-bold text-slate-900">
              {plan.price.split("/")[0]}
            </span>
            <span class="text-lg text-slate-600">
              /{plan.price.split("/")[1]}
            </span>
          </div>
        ) : (
          <p class="text-4xl md:text-5xl font-bold text-slate-900">
            {plan.price && typeof plan.price === "object" ? plan.price.monthly : plan.price}
          </p>
        )}
      </div>
      {plan.note && (
        <p class="mt-3 text-sm text-slate-600 min-h-[40px]">
          {plan.note}
        </p>
      )}
    </div>

    <ul class="grid mt-8 text-left gap-y-4 flex-grow">
      {
        plan.features.map((item) => (
          <li class="flex items-start gap-3 text-slate-700">
            <Tick class="w-6 h-6 flex-shrink-0" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <div class="flex mt-8">
      <Link
        href={plan.button.link || "#"}
        block
        style={plan.popular ? "primary" : "outline"}>
        {plan.button.text || "Get Started"}
      </Link>
    </div>
  </div>
</div>
