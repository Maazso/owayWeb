---
import { Picture } from "astro:assets";
import heroImage from "assets/hero.png";
import owayBooster from "assets/owayBooster.png";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-2 md:pt-6 ">
  <div class="py-6 md:order-1 hidden md:block bg-[#1C3D48] rounded-2xl p-8">
    <img
      src="/app_screen.png"
      alt="OWAY App Interface showing login screen and mobile dashboard with Email, Calendar, and Phone Tasks"
      class="w-full h-auto rounded-lg shadow-2xl"
      loading="eager"
    />
  </div>
  <div class="max-w-2xl">
    <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-blue-50 to-purple-50 border border-blue-200 rounded-full mb-4">
      <span class="text-2xl">✨</span>
      <span class="text-sm font-semibold text-blue-700">AI-Powered Email Intelligence</span>
    </div>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-gray-900 max-w-2xl">
      Let AI draft your replies, <br class="hidden sm:inline" />
      prioritize your VIPs, and <br class="hidden lg:inline" />
      automate your inbox — in seconds.
    </h1>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
<a
  href="https://docs.google.com/forms/d/e/1FAIpQLSca_5ez9SbxFeilS8z-KPIROOC6rgIrnetf4HSf3mAZnoB-Bg/viewform?usp=dialog"
  target="_blank"
  rel="noopener noreferrer"
  class="px-6 py-3 text-white bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg text-lg font-semibold hover:from-blue-700 hover:to-purple-700 transition shadow-lg"
>
  Start Free Trial
</a>
      <a
        href="/contact"
        class="px-6 py-3 text-black bg-white border border-gray-300 rounded-lg text-lg font-semibold hover:bg-gray-100 transition">
        Book a Demo
      </a>
    </div>
    <p class="text-base mt-6 text-slate-600 max-w-xl">
      OWAY uses advanced AI to understand every email, generate perfect replies in 4 tones,
      automatically identify VIPs, provide relationship insights, and save you 10+ hours per week
      with intelligent automation.
    </p>
    <div class="mt-6 flex flex-wrap gap-4 text-sm text-slate-700">
      <div class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span>
        <span>Smart Reply with 4 tones</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span>
        <span>VIP Auto-Detection</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span>
        <span>Email Autopilot</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span>
        <span>Sender Insights</span>
      </div>
    </div>
  </div>
</main>
