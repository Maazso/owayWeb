---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
---
<Layout title="Terms of Use">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Terms of Use</Fragment>
      <Fragment slot="desc">
        These Terms of Use govern your access to and use of OWAY’s AI-powered communication and productivity platform. By using OWAY, you agree to these legally binding terms.
      </Fragment>
    </Sectionhead>

    <!-- 1. Introduction -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">1. Introduction</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Welcome to OWAY. These Terms of Use ("Terms") govern your use of OWAY’s services and applications. By using OWAY, you agree to comply with and be bound by these Terms. If you do not agree, you may not access or use the Service.
      </p>
    </div>

    <!-- 2. Eligibility -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">2. Eligibility</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        You must be at least 18 years of age and legally capable of entering a binding agreement to use OWAY.
      </p>
    </div>

    <!-- 3. Account Registration -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">3. Account Registration & Security</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        You are responsible for maintaining the confidentiality of your account credentials. OWAY is not liable for any loss due to unauthorized access resulting from your actions.
      </p>
    </div>

    <!-- 4. Description of Service -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">4. Description of Service</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY provides intelligent communication tools that automate email organization, calendar scheduling, and phone call handling using AI technologies. We may update, modify, or discontinue parts of the Service at our discretion.
      </p>
    </div>

    <!-- 5. Acceptable Use -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">5. Acceptable Use</h2>
      <ul class="list-disc list-inside text-lg text-slate-500">
        <li>Do not use OWAY for illegal or harmful activities.</li>
        <li>Do not tamper with, reverse engineer, or disrupt the Service.</li>
        <li>Do not upload malware or unauthorized data.</li>
        <li>Do not resell the Service without permission.</li>
      </ul>
    </div>

    <!-- 6. User Content -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">6. User Content & Permissions</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        You retain ownership of your content. By submitting content, you grant OWAY a secure, limited license to process and use it to deliver and improve our services. We do not sell your data.
      </p>
    </div>

    <!-- 7. Intellectual Property -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">7. Intellectual Property</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY and its associated logos, software, and services are protected by copyright and trademark laws. You may not use OWAY branding or software without written consent.
      </p>
    </div>

    <!-- 8. Subscription & Billing -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">8. Subscription & Billing</h2>

      <h3 class="font-semibold text-xl text-gray-700 mt-4">8.1 Subscription Plans</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY offers auto-renewable subscription plans including:
      </p>
      <ul class="list-disc list-inside text-lg text-slate-500 ml-4">
        <li><strong>OWAY Pro Monthly:</strong> $10.00 USD per month (or equivalent in your local currency)</li>
        <li><strong>OWAY Pro Yearly:</strong> $100.00 USD per year (or equivalent in your local currency)</li>
      </ul>
      <p class="text-lg leading-relaxed text-slate-500 mt-2">
        Pricing may vary by region and is subject to applicable taxes and fees.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.2 Auto-Renewal Terms</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        <strong>Your subscription will automatically renew unless you cancel at least 24 hours before the end of the current billing period.</strong> You will be charged for the renewal within 24 hours prior to the end of the current period at the same rate as your initial subscription.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.3 Payment Processing</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        Subscriptions are processed through:
      </p>
      <ul class="list-disc list-inside text-lg text-slate-500 ml-4">
        <li><strong>iOS/Apple Devices:</strong> Apple In-App Purchase (managed through your Apple ID)</li>
        <li><strong>Android/Web:</strong> Stripe payment processing</li>
      </ul>
      <p class="text-lg leading-relaxed text-slate-500 mt-2">
        By subscribing, you authorize recurring charges to your payment method on file with the respective payment processor.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.4 How to Cancel Your Subscription</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        You may cancel your subscription at any time:
      </p>
      <ul class="list-disc list-inside text-lg text-slate-500 ml-4">
        <li><strong>iOS Users:</strong> Open Settings → [Your Name] → Subscriptions → OWAY → Cancel Subscription</li>
        <li><strong>Android Users:</strong> Open Google Play Store → Menu → Subscriptions → OWAY → Cancel Subscription</li>
        <li><strong>Web Users:</strong> Manage subscriptions through your Stripe customer portal (link provided in subscription confirmation email)</li>
      </ul>
      <p class="text-lg leading-relaxed text-slate-500 mt-2">
        Cancellation takes effect at the end of your current billing period. You will retain access to premium features until that date.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.5 Free Trials</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        If a free trial is offered, you will have access to premium features for the trial duration at no charge. <strong>Unless you cancel before the trial ends, your subscription will automatically convert to a paid subscription</strong> and you will be charged the applicable subscription fee.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.6 Refund Policy</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        <strong>No partial refunds are offered for unused portions of subscription periods.</strong> If you cancel mid-cycle, you retain access until the end of your billing period but will not receive a prorated refund.
      </p>
      <p class="text-lg leading-relaxed text-slate-500 mt-2">
        For iOS subscriptions, refund requests must be submitted directly to Apple through your Apple ID account. OWAY does not control Apple's refund decisions.
      </p>
      <p class="text-lg leading-relaxed text-slate-500 mt-2">
        For Stripe subscriptions, refund requests can be submitted to <a href="mailto:darkeagent@gmail.com" class="text-blue-600 underline">darkeagent@gmail.com</a> and will be reviewed on a case-by-case basis.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.7 Price Changes</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY reserves the right to modify subscription pricing with at least 30 days' notice. Existing subscribers will be notified via email before any price increase takes effect. Price changes will apply to your next billing cycle after the notice period.
      </p>

      <h3 class="font-semibold text-xl text-gray-700 mt-6">8.8 Account Suspension for Non-Payment</h3>
      <p class="text-lg leading-relaxed text-slate-500">
        If a subscription payment fails, OWAY may suspend access to premium features until payment is successfully processed. We will attempt to notify you via email if payment issues occur.
      </p>
    </div>

    <!-- 9. Termination -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">9. Termination</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY may suspend or terminate your access if you violate these Terms or if required by law. Upon termination, we will delete or retain your data as outlined in our Privacy Policy.
      </p>
    </div>

    <!-- 10. Disclaimers -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">10. Disclaimers</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        The Service is provided "as-is" without warranties. We do not guarantee the accuracy of AI-generated content or uninterrupted access.
      </p>
    </div>

    <!-- 11. Limitation of Liability -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">11. Limitation of Liability</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY is not liable for indirect or consequential damages. Our total liability is limited to the greater of $100 or the amount you paid us in the past 12 months.
      </p>
    </div>

    <!-- 12. Indemnification -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">12. Indemnification</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        You agree to indemnify and hold OWAY harmless from claims arising from your use of the Service or violation of these Terms.
      </p>
    </div>

    <!-- 13. Governing Law -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">13. Governing Law & Dispute Resolution</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        These Terms are governed by the laws of the State of [Insert State]. Disputes will be resolved through binding arbitration under the rules of the American Arbitration Association. You waive your right to class actions.
      </p>
    </div>

    <!-- 14. Updates -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-3xl text-gray-800">14. Changes to Terms</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        OWAY may revise these Terms at any time. We will notify users of significant changes. Continued use of the Service means you accept the new Terms.
      </p>
    </div>

    <!-- 15. Contact -->
    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-12 mb-24">
      <h2 class="font-bold text-3xl text-gray-800">15. Contact Us</h2>
      <p class="text-lg leading-relaxed text-slate-500">
        📧 Email: darkeagent@gmail.com <br />
        📞 Phone: +1-815-764-5878
      </p>
    </div>
  </Container>
</Layout>