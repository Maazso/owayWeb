---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import PricingCard from "@components/pricing.astro";
const pricing = [
  {
    name: "Plus Plan",
    price: "$13.50/month",
    popular: false,
    features: [
      "1 inbox and calendar per user",
      "The best email drafts",
      "Email Sorting and Categorization",
      "Meeting Notetaker",
    ],
    button: {
      text: "Get Started for Free",
      link: "https://forms.gle/TFHH2vHVaXax5VdS8",
    },
    note: "7-day free trial included — cancel anytime",
  },
  {
    name: "Pro Plan",
    price: "$35.50/month",
    popular: true,
    features: [
      "Everything in Plus",
      "Extended usage limits",
      "Priority support",
      "Custom integrations",
      "Multi-Account Support",
    ],
    button: {
      text: "Get Started for Free",
      link: "https://forms.gle/TFHH2vHVaXax5VdS8",
    },
    note: "7-day free trial included — cancel anytime",
  },
  {
    name: "Team Plan",
    price: "Talk to sales",
    popular: false,
    features: [
      "Advanced features",
      "Team-wide rules",
      "Usage-based pricing",
      "Dedicated Account Manager",
    ],
    button: {
      text: "Talk to sales",
      link: "/contact",
    },
  },
];
---

<Layout title="Pricing">
  <Container class="pb-10">
    <Sectionhead>
      <Fragment slot="title">Pricing</Fragment>
      <Fragment slot="desc">
        Simple & Predictable pricing. No Surprises.
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-screen-lg mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
